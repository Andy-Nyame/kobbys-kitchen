{
  "name": "kobbyskitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/tests/*.test.js",
    "test:development:integration": "RUN_DEVELOPMENT_INTEGRATION_TESTS=1 node --env-file-if-exists=.env.local --test src/tests/admin-menu.integration.test.js src/tests/admin-ordering-operations.integration.test.js src/tests/development-neon.integration.test.js src/tests/menu-catalogue.integration.test.js src/tests/reviews-moderation.integration.test.js src/tests/universal-customer-profile.integration.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed:development": "node --env-file-if-exists=.env.local scripts/seed-development.js",
    "migrate:supabase-development": "node --env-file-if-exists=.env.local scripts/migrate-supabase-development.js",
    "test:development:backend": "node --env-file-if-exists=.env.local scripts/acceptance/backend-migration.js",
    "test:development:admin-menu": "node --env-file-if-exists=.env.local scripts/acceptance/admin-menu.js",
    "provision:primary-admin": "node --env-file-if-exists=.env.local scripts/provision-primary-admin.js",
    "provision:primary-admin:production": "node --env-file-if-exists=.env.admin-production.local scripts/provision-primary-admin-production.js",
    "cleanup:dummy-customers:production": "node --env-file-if-exists=.env.admin-production.local scripts/cleanup-production-dummy-customers.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.10.0"
  }
}
