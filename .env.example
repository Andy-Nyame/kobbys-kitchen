# REQUIRED PRODUCTION RUNTIME
# Use development-safe values in .env.local. Production values belong in the
# deployment environment and must never be committed.
APP_ENV=development
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
V2_ORDERING_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_ENABLED=false
ONLINE_PAYMENT_REQUIRED=false

# OPTIONAL PRODUCTION RUNTIME
# Comma-separated trusted customer emails. Values are normalized server-side;
# blank or missing configuration disables Cash on Pickup for every account.
CASH_ON_PICKUP_ALLOWED_EMAILS=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LOCAL ADMIN / PROVISIONING
# These identify the approved Neon targets and existing Auth.js users for the
# guarded provisioning and cleanup commands. They are never browser roles.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_DEVELOPMENT_BRANCH_ID=
PRIMARY_ADMIN_EMAIL=
PRIMARY_CHEF_EMAIL=

# DEVELOPMENT / TEST
RUN_DEVELOPMENT_INTEGRATION_TESTS=0
# SUPABASE_DB_URL=

# PLATFORM PROVIDED (do not set manually on Vercel)
# NODE_ENV=
# VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
